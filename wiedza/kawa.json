    "kawa": {"typ": "wniosek", "wartosci": ["mrożona kawa bezkofeinowa", "latte bezkofeinowe", "chocolate cold coffee", "iced latte", "cold brew", "mocha", "latte", "cappuccino", "espresso", "americano"]}
  },
  "reguly": [
